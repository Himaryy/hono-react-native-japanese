{"nodes": [{"id": "claude_md_jlpt_learning_app", "label": "JLPT Learning App (Root Project)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": "2026-06-15", "author": null, "contributor": null, "rationale": "React Native (Expo) frontend only; backend already built and deployed on Vercel. Two-repo split keeps concerns separated and prevents accidental modification of deployed auth/DB/API."}, {"id": "claude_md_expo_frontend_stack", "label": "Expo Frontend Stack", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Frontend Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Native + Expo for cross-platform UI; React Navigation for tabs; TanStack Query for all API calls and caching (never fetch directly in components); Zustand for global state; NativeWind for Tailwind-style styling; Better Auth client for session cookies."}, {"id": "claude_md_hono_backend", "label": "Hono Backend (Already Built)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Two-Repo Split", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hono chosen for lightweight Edge Functions native design; deployed on Vercel Edge. Do not modify auth, DB schema, or API structure."}, {"id": "claude_md_better_auth", "label": "Better Auth", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Frontend Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free, open-source, MIT license; handles password hashing (argon2), session tokens, CSRF protection; uses HttpOnly cookies so JS cannot access session; Drizzle ORM adapter eliminates manual queries."}, {"id": "claude_md_neon_postgresql", "label": "Neon PostgreSQL (Serverless)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Two-Repo Split", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serverless PostgreSQL chosen for connection pooling and free tier; source of truth for all user data."}, {"id": "claude_md_drizzle_orm", "label": "Drizzle ORM", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Type-safe ORM with no migration pain; integrates with Better Auth adapter."}, {"id": "claude_md_tanstack_query", "label": "TanStack Query", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Frontend Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces AsyncStorage and direct fetch in components; handles caching, loading states, and error states automatically."}, {"id": "claude_md_zustand", "label": "Zustand", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Frontend Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightweight global state without Redux boilerplate; stores user profile and session."}, {"id": "claude_md_nativewind", "label": "NativeWind", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Frontend Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_md_navigation_structure", "label": "Navigation Structure (AuthStack + MainTabs)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Navigation Structure", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_md_static_content", "label": "N5 Static Content (JSON + Audio)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > Static Content", "source_url": null, "captured_at": null, "aut